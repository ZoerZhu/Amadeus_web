AMADEUS_SQLITE_PATH=agent_state/amadeus_web.sqlite3
AMADEUS_LOCAL_TTS_ENABLED=1
AMADEUS_LOCAL_TTS_URL=http://127.0.0.1:8011
AMADEUS_COSYVOICE_PROMPT_TEXT=ふんよくも私の正体を聞けたものだ私はマセ効率世界で最も才能のある女性科学者よでもクリスチーナって呼ばないでそのニックネームは好きじゃないのよ何か質問があるなら彼らに聞いてちょうだいあなたとおしゃべりする時間なんてそうそうないんだから
AMADEUS_SPEECH_SEGMENT_TARGET_CHARS=30
AMADEUS_SPEECH_SEGMENT_MAX_CHARS=55
AMADEUS_SPEECH_SEGMENT_HARD_BREAK_MIN_CHARS=20
AMADEUS_PROVIDER=OpenAI
AMADEUS_BASE_URL=https://api.openai.com/v1
AMADEUS_MODEL=gpt-4.1-mini
AMADEUS_API_KEY=
AMADEUS_VISION_PROVIDER=
AMADEUS_VISION_BASE_URL=
AMADEUS_VISION_MODEL=gpt-4.1-mini
AMADEUS_VISION_API_KEY=
AMADEUS_VISION_IMAGE_MAX_BYTES=10485760
AMADEUS_SPEECH_INPUT_PROVIDER=小米 MiMo ASR
AMADEUS_SPEECH_INPUT_BASE_URL=https://api.xiaomimimo.com/v1
AMADEUS_SPEECH_INPUT_MODEL=mimo-v2.5-asr
AMADEUS_SPEECH_INPUT_API_KEY=
AMADEUS_SPEECH_INPUT_LANGUAGE=auto
MIMO_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_VOICE_URI=
AMADEUS_SEARXNG_URL=
AMADEUS_SEARCH_FETCH_TOP_N=4
AMADEUS_SEARCH_USER_AGENT=AmadeusWebSearch/0.1
AMADEUS_DOC_WRITER_OUTPUT_DIR=generated_docs
AMADEUS_TODO_TASK_STORE=agent_state/todo_tasks.json
# ---- Rate Limiting ----
AMADEUS_RATE_LIMIT_DISABLED=0
AMADEUS_RATE_LIMIT_WINDOW_SECONDS=60
AMADEUS_RATE_LIMIT_MAX_REQUESTS=300
AMADEUS_RATE_LIMIT_HEAVY_MAX=30

# ---- Security Headers ----
AMADEUS_SECURITY_CSP=
AMADEUS_SECURITY_HSTS=0

# ---- Memory System ----
AMADEUS_MEMORY_ENABLED=1
AMADEUS_MEMORY_EXTRACT_INTERVAL=6
AMADEUS_MEMORY_SUMMARY_INTERVAL=12
AMADEUS_MEMORY_DOMAIN_TOP_K=3
AMADEUS_MEMORY_NODE_TOP_K=8
AMADEUS_MEMORY_LEAF_TOP_K=8
AMADEUS_MEMORY_MIN_IMPORTANCE=0.3
AMADEUS_MEMORY_MIN_CONFIDENCE=0.5
AMADEUS_MEMORY_CONTEXT_CHAR_BUDGET=5000
AMADEUS_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
AMADEUS_MEMORY_EMBEDDING_DIM=1536
AMADEUS_MEMORY_EXTRACT_TIMEOUT=60
AMADEUS_MEMORY_RETRIEVE_TIMEOUT=5
AMADEUS_MEMORY_JOB_MAX_ATTEMPTS=3

# ---- CORS ----
AMADEUS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
