{
  "name": "amadeus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api": "uvicorn backend.amadeus_app.main:app --reload --host 127.0.0.1 --port 8000",
    "desktop:backend": "powershell -ExecutionPolicy Bypass -File scripts\\package_backend.ps1",
    "desktop:build": "powershell -ExecutionPolicy Bypass -File scripts\\package_desktop.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.amadeus.web.desktop",
    "productName": "Amadeus",
    "asar": true,
    "directories": {
      "output": "release\\electron"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release\\backend\\amadeus-backend",
        "to": "backend\\amadeus-backend"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Amadeus-${version}-win-x64.exe"
    }
  }
}
